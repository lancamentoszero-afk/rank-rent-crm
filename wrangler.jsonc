{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rank-rent-crm",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Sem endereços de pré-visualização: só existe a versão em produção, protegida pelo Access
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rank-rent-crm",
      // Substituir pelo ID que o comando `wrangler d1 create rank-rent-crm` devolver
      "database_id": "9b8d17a1-53e6-4393-be81-1ee55c6a0c40",
      "migrations_dir": "migrations"
    }
  ],
  // Busca diária ao Search Console (06:15 UTC)
  "triggers": { "crons": ["15 6 * * *"] },
  "vars": {
    // Domínio da equipa do Cloudflare Access, ex: "fabio.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // "Application Audience (AUD) Tag" da aplicação no Cloudflare Access
    "ACCESS_AUD": "",
    // Email do administrador (entra sempre, mesmo sem estar na tabela de utilizadores)
    "ADMIN_EMAIL": "lancamentoszero@gmail.com"
  }
  // Segredos (não ficam aqui): GSC_SERVICE_ACCOUNT  ->  npx wrangler secret put GSC_SERVICE_ACCOUNT
}
